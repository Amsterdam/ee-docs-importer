{
  "name": "ee-docs-importer",
  "private": true,
  "version": "0.1.2",
  "main": "dist/importer.js",
  "scripts": {
    "import": "node ./dist/importer.js",
    "build": "npx esbuild ./src/importer.ts --bundle --outfile=dist/importer.js --platform=node --minify",
    "dev": "npx esbuild ./src/importer.ts --bundle --outfile=dist/importer.js --platform=node --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint:scripts": "eslint . --ext .ts,.json",
    "format:scripts": "prettier . --write",
    "format": "npm run format:scripts",
    "prepare": "husky",
    "uninstall-husky": "npm uninstall husky --no-save && git config --unset core.hooksPath && npx rimraf .husky",
    "release": "release-it"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.9",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "memfs": "^4.57.8",
    "prettier": "^3.8.4",
    "release-it": "^20.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "simple-git": "^3.36.0",
    "vfile": "^6.0.3",
    "vfile-message": "^4.0.3",
    "vfile-reporter": "^8.1.1"
  }
}
